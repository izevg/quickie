#!/bin/sh
# Builds Quickie on the applied checkout (engine/chromium/scripts/sync, then apply): writes args.gn
# (ungoogled-chromium's flags.gn, then engine/chromium/scripts/args.gn), runs gn gen and gn check on
# //quickie, then autoninja (Siso) with a job cap.
#
#   engine/chromium/scripts/build [target...]   default target: chrome
#
# Environment:
#   QUICKIE_BUILD_DIR    as in sync (default: <repo>/.build)
#   QUICKIE_OUT          output directory inside src (default: out/Quickie)
#   QUICKIE_JOBS         parallel jobs (default: one per 2 GB of RAM, at most one per CPU)
#   QUICKIE_MIN_FREE_GB  refuse to run below this much free disk (default: 25)
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/../../.." && pwd)
build=${QUICKIE_BUILD_DIR:-$root/.build}
min_free_gb=${QUICKIE_MIN_FREE_GB:-25}
src=$build/chromium/src
out=${QUICKIE_OUT:-out/Quickie}

die() {
  printf 'build: %s\n' "$1" >&2
  exit 1
}

# Same guard as sync: a link step that runs out of disk leaves a corrupt output directory.
preflight() {
  free_gb=$(df -Pk "$1" | awk 'NR == 2 { print int($4 / 1048576) }')
  if [ "$free_gb" -lt "$min_free_gb" ]; then
    die "only ${free_gb} GB free on the disk of $1; need ${min_free_gb} GB (QUICKIE_MIN_FREE_GB)"
  fi
}

[ -f "$src/.quickie-applied" ] || die "the checkout is not applied; run engine/chromium/scripts/apply"
preflight "$src"
export DEPOT_TOOLS_UPDATE=0
PATH="$build/depot_tools:$PATH"
export PATH

if [ -z "${QUICKIE_JOBS:-}" ]; then
  # Chromium's compile and link steps take 1-2 GB each; more jobs than that swaps.
  cpus=$(sysctl -n hw.ncpu)
  QUICKIE_JOBS=$(($(sysctl -n hw.memsize) / 2147483648))
  [ "$QUICKIE_JOBS" -le "$cpus" ] || QUICKIE_JOBS=$cpus
  [ "$QUICKIE_JOBS" -ge 1 ] || QUICKIE_JOBS=1
fi
case "$QUICKIE_JOBS" in
  '' | *[!0-9]*) die "QUICKIE_JOBS must be a number: $QUICKIE_JOBS" ;;
esac

cd "$src"
mkdir -p "$out"
# Rewrite args.gn only when it changes, so an unchanged configuration does not regenerate.
{
  printf '# Generated by engine/chromium/scripts/build: ungoogled flags.gn, then engine/chromium/scripts/args.gn.\n'
  cat "$build/ungoogled/flags.gn"
  cat "$root/engine/chromium/scripts/args.gn"
} >"$out/args.gn.new"
if cmp -s "$out/args.gn.new" "$out/args.gn"; then
  rm "$out/args.gn.new"
else
  mv "$out/args.gn.new" "$out/args.gn"
fi

gn gen "$out"
gn check "$out" '//quickie/*'

if [ "$#" -eq 0 ]; then
  set -- chrome
fi
autoninja -C "$out" -j "$QUICKIE_JOBS" "$@"
printf 'build: %s/%s\n' "$src" "$out"
