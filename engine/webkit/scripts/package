#!/bin/sh
# Packs what engine/webkit/scripts/build produced into one archive for engine-webkit to consume:
# the frameworks of WebKitBuild/Release, the dylibs and the XPC services next to them
# (WebKit.framework/Versions/A/XPCServices links to those by relative paths, so the layout is kept
# as it is), and BUILD-INFO (pin, toolchain, host). Writes <name>.tar.gz and
# <name>.tar.gz.sha256 into the output directory and prints both paths.
#
#   engine/webkit/scripts/package [output-dir]     default output-dir: <build>/webkit-package
#
# Environment:
#   QUICKIE_BUILD_DIR   where the checkout is (default: <repo>/.build)
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/../../.." && pwd)
build=${QUICKIE_BUILD_DIR:-$root/.build}
src=$build/webkit
release=$src/WebKitBuild/Release
out=${1:-$build/webkit-package}

die() {
  printf 'package: %s\n' "$1" >&2
  exit 1
}

[ -d "$release/WebKit.framework" ] || die "no WebKit.framework in $release; run engine/webkit/scripts/build"
commit=$(git -C "$src" rev-parse 'HEAD^{commit}')
arch=$(uname -m)
name=webkit-macos-$arch-$(printf '%s' "$commit" | cut -c1-12)
mkdir -p "$out"
archive=$out/$name.tar.gz

cd "$release"
set --
for item in *.framework *.dylib *.xpc; do
  [ -e "$item" ] && set -- "$@" "$item"
done
[ "$#" -gt 0 ] || die "nothing to pack in $release"

{
  printf 'webkit_commit=%s\n' "$commit"
  printf 'webkit_repo=%s\n' "$(git -C "$src" remote get-url origin)"
  printf 'quickie_commit=%s\n' "$(git -C "$root" rev-parse HEAD 2>/dev/null || echo unknown)"
  printf 'xcode=%s\n' "$(xcodebuild -version | tr '\n' ' ' | sed 's/ $//')"
  printf 'sdk=macosx%s\n' "$(xcrun --show-sdk-version)"
  printf 'host=macOS %s %s\n' "$(sw_vers -productVersion)" "$arch"
  printf 'configuration=Release\n'
  printf 'built=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'contents=%s\n' "$*"
} >"$out/BUILD-INFO"

# Frameworks keep their Versions/Current symlinks: tar stores links as links.
tar -czf "$archive" "$@" -C "$out" BUILD-INFO
(cd "$out" && shasum -a 256 "$name.tar.gz" >"$name.tar.gz.sha256")

printf 'package: %s (%s)\n' "$archive" "$(du -h "$archive" | cut -f1)"
printf 'package: %s\n' "$(cat "$archive.sha256")"
printf 'package: contents: %s BUILD-INFO\n' "$*"
# On GitHub Actions, hand the names to the following steps.
if [ -n "${GITHUB_OUTPUT:-}" ]; then
  printf 'name=%s\narchive=%s\n' "$name" "$archive" >>"$GITHUB_OUTPUT"
fi
