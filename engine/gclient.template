# .gclient for a no-history checkout of the pinned Chromium tag. engine/scripts/sync replaces
# @CHROMIUM_VERSION@ with the value from engine/chromium.pin and writes the result to
# .build/chromium/.gclient. Python syntax (gclient reads it with exec).
#
# Vars come from //DEPS at the pinned tag (checked 2026-11-19, 156.0.8078.109):
# - checkout_configuration "small" skips test-only bundles (Meet GPU effects, press benchmarks).
# - PGO profiles are fetched from Google Cloud Storage; args.gn sets chrome_pgo_phase = 0, so they
#   are not needed and not fetched.
# - No src-internal, Android, Fuchsia, Chrome OS or iOS dependencies.
solutions = [
  {
    "name": "src",
    "url": "https://chromium.googlesource.com/chromium/src.git@refs/tags/@CHROMIUM_VERSION@",
    "managed": False,
    "custom_deps": {},
    "custom_vars": {
      "checkout_configuration": "small",
      "checkout_pgo_profiles": False,
      "checkout_src_internal": False,
      "checkout_android": False,
      "checkout_fuchsia": False,
      "checkout_js_coverage_modules": False,
      "checkout_telemetry_dependencies": False,
    },
  },
]
target_os = ["mac"]
target_os_only = True
