# //quickie: Quickie's code inside the Chromium tree (docs/architecture.md, section 4.4).
# engine/scripts/apply links engine/quickie here as src/quickie, and the repository's crates/ as
# src/quickie_crates; engine/patches/startup/link-quickie.patch links this target into Chrome.
#
# P1 components: bridge/ (cxx bridge and the tab registry), browser_window/ (the BrowserWindow
# without BrowserView), keyboard/ (key equivalents for the Rust shell). The others in section 4.4
# (swipe, shields, net_bridge, privacy, agent_bridge) come in later phases.
#
# Dependency labels were read from the BUILD.gn files at 156.0.8078.109;
# TODO(verify): engine/scripts/build runs `gn check` on //quickie/*, which names any missing one.

import("//build/rust/rust_static_library.gni")

assert(is_mac, "Quickie's engine is macOS only")

_engine_chromium = "//quickie_crates/adapters/engine-chromium/src"

source_set("quickie") {
  sources = [
    "bridge/quickie_bridge.cc",
    "bridge/tab_registry.cc",
    "bridge/tab_registry.h",
    "browser_window/quickie_browser_window.h",
    "browser_window/quickie_browser_window.mm",
    "browser_window/window_factory.mm",
    "keyboard/key_equivalents.h",
    "keyboard/key_equivalents.mm",
    "main_parts.cc",
    "main_parts.h",
  ]
  public_deps = [ ":bridge_header" ]
  deps = [
    ":engine_chromium",
    "//base",
    "//chrome/browser",
    "//chrome/browser:main_extra_parts",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/themes",
    "//chrome/browser/ui",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/browser_window:create_browser_window",
    "//chrome/common",
    "//components/input",
    "//components/tabs:public",
    "//content/public/browser",
    "//third_party/blink/public/common:headers",
    "//ui/base",
    "//ui/color",
    "//ui/gfx",
    "//ui/native_theme",
    "//url",
  ]
  frameworks = [
    "AppKit.framework",
    "Foundation.framework",
  ]
}

# The bridge's C++ declarations, on their own so the cxx-generated code (which includes this
# header) does not depend on :quickie, which depends on the Rust library: no cycle.
source_set("bridge_header") {
  public = [ "bridge/quickie_bridge.h" ]
  public_deps = [ "//build/rust:cxx_cppdeps" ]
}

# The Rust side (crates/adapters/engine-chromium, the quickie-engine-chromium crate). Cargo
# builds the same sources without the `chromium` feature for development and tests.
# TODO(verify): the template accepts a crate_root outside this directory (it rebases the path,
# so it should); else move this target into a BUILD.gn next to the crate.
rust_static_library("engine_chromium") {
  crate_root = "$_engine_chromium/lib.rs"
  sources = [
    "$_engine_chromium/bridge.rs",
    "$_engine_chromium/bridge/dispatch.rs",
    "$_engine_chromium/engine.rs",
    "$_engine_chromium/engine/inbox.rs",
    "$_engine_chromium/engine/reports.rs",
    "$_engine_chromium/ffi.rs",
    "$_engine_chromium/lib.rs",
  ]
  cxx_bindings = [ "$_engine_chromium/ffi.rs" ]
  features = [ "chromium" ]
  edition = "2024"

  # The crate opts in itself with #![expect(unsafe_code, reason = ...)]; Chromium's default
  # (-Funsafe_code) would make that a hard error.
  allow_unsafe = true

  # Mirrors the Cargo workspace lint, so the #![expect] stays fulfilled under GN too.
  rustflags = [ "-Dunsafe_code" ]

  # The generated C++ includes bridge/quickie_bridge.h.
  # TODO(verify): the crate now also depends on quickie-application, quickie-domain-browsing and
  # url (crates/adapters/engine-chromium/Cargo.toml); each needs a GN target here, the workspace
  # crates as rust_static_library and url through gnrt (engine/README.md, open question 7).
  deps = [ ":bridge_header" ]
}
