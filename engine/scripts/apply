#!/bin/sh
# Turns the synced Chromium checkout (engine/scripts/sync) into Quickie's source tree:
#
#   1. ungoogled-chromium binary pruning (keeping the Google toolchains depot_tools fetched),
#   2. the ungoogled-chromium patch series, then a curated subset of the macOS platform series,
#   3. ungoogled-chromium domain substitution,
#   4. our series, engine/patches/series,
#   5. our whole-file overrides, engine/overrides/ copied over the tree,
#   6. //quickie: src/quickie -> engine/quickie and src/quickie_crates -> crates (Rust sources).
#
# Steps 1-4 change the tree once; a stamp records what was applied. Re-running with the same pin
# and patches only refreshes steps 5 and 6 (so editing an override or //quickie needs no reset);
# anything else needs 'engine/scripts/sync --reset' first, and this script says so.
#
# Environment:
#   QUICKIE_BUILD_DIR       as in sync (default: <repo>/.build)
#   QUICKIE_MIN_FREE_GB     refuse to run below this much free disk (default: 25)
#   QUICKIE_MACOS_PATCHES   space-separated patches of ungoogled-chromium-macos to apply, relative
#                           to its patches/ (default: the subset below)
#   PATCH_BIN               the patch binary ungoogled's patches.py uses (GNU patch recommended)
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
# shellcheck source=/dev/null # engine/chromium.pin: plain assignments, nothing to check
. "$root/engine/chromium.pin"
build=${QUICKIE_BUILD_DIR:-$root/.build}
min_free_gb=${QUICKIE_MIN_FREE_GB:-25}
src=$build/chromium/src
ungoogled=$build/ungoogled
ungoogled_macos=$build/ungoogled-macos
stamp=$src/.quickie-applied
partial=$src/.quickie-applying

# The macOS platform series is written for its own tarball build with self-built toolchains
# (bindgen, Rust sysroot, clang version checks, system Python); with depot_tools' toolchains most
# of it is wrong. This keeps only what a depot_tools build with safe_browsing_mode = 0 needs.
# TODO(verify): the first real build decides whether more of that series is needed.
default_macos_patches='ungoogled-chromium/macos/fix-disabling-safebrowsing.patch'
macos_patches=${QUICKIE_MACOS_PATCHES:-$default_macos_patches}

die() {
  printf 'apply: %s\n' "$1" >&2
  exit 1
}

# Same guard as sync: refuse to start on a nearly full disk.
preflight() {
  free_gb=$(df -Pk "$1" | awk 'NR == 2 { print int($4 / 1048576) }')
  if [ "$free_gb" -lt "$min_free_gb" ]; then
    die "only ${free_gb} GB free on the disk of $1; need ${min_free_gb} GB (QUICKIE_MIN_FREE_GB)"
  fi
}

# Points $1 at $2 unless it already does.
link() {
  if [ "$(readlink "$1" 2>/dev/null || true)" != "$2" ]; then
    rm -f "$1"
    ln -s "$2" "$1"
  fi
}

[ -d "$src/.git" ] || die "no checkout at $src; run engine/scripts/sync first"
[ -d "$ungoogled/patches" ] || die "no ungoogled-chromium at $ungoogled; run engine/scripts/sync"
preflight "$src"
export DEPOT_TOOLS_UPDATE=0
PATH="$build/depot_tools:$PATH"
export PATH

# What steps 1-4 depend on. Any change means a different tree.
fingerprint=$(
  {
    printf '%s %s %s %s\n' "$CHROMIUM_COMMIT" "$UNGOOGLED_COMMIT" "$UNGOOGLED_MACOS_COMMIT" \
      "$macos_patches"
    find "$root/engine/patches" -type f | LC_ALL=C sort | xargs cat
  } | shasum -a 256 | cut -d ' ' -f 1
)

if [ -f "$stamp" ]; then
  [ "$(cat "$stamp")" = "$fingerprint" ] ||
    die "the tree was patched from other inputs; run 'engine/scripts/sync --reset' and apply again"
  printf 'apply: patches already applied; refreshing overrides and links\n'
else
  # A failure halfway leaves a partly patched tree that cannot be patched again.
  [ ! -f "$partial" ] ||
    die "an earlier apply stopped halfway; run 'engine/scripts/sync --reset' and apply again"
  : >"$partial"

  # 1. Pruning. --keep-contingent-paths keeps the toolchains (clang, Rust, siso, ninja) that
  # depot_tools fetched; we build with them. pruning.list is written for the release tarball, so
  # a git checkout lacks some listed files: prune_binaries.py exits 1 for those, which is fine.
  log=$build/prune.log
  if ! python3 "$ungoogled/utils/prune_binaries.py" --keep-contingent-paths \
    "$src" "$ungoogled/pruning.list" >"$log" 2>&1; then
    grep -q 'files could not be pruned' "$log" || {
      cat "$log" >&2
      die "binary pruning failed"
    }
    printf 'apply: pruning skipped files absent from a git checkout (see %s)\n' "$log"
  fi

  # 2. ungoogled-chromium's series, then the macOS subset (copied into a series of its own).
  subset=$build/ungoogled-macos-subset
  rm -rf "$subset"
  mkdir -p "$subset"
  : >"$subset/series"
  for patch in $macos_patches; do
    mkdir -p "$subset/$(dirname "$patch")"
    cp "$ungoogled_macos/patches/$patch" "$subset/$patch"
    printf '%s\n' "$patch" >>"$subset/series"
  done
  # TODO(verify): patches.py runs `patch -p1 --ignore-whitespace`; macOS ships patch 2.0-Apple.
  # If hunks fail that GNU patch would apply, install GNU patch and set PATCH_BIN to it.
  python3 "$ungoogled/utils/patches.py" apply "$src" "$ungoogled/patches" "$subset"

  # 3. Domain substitution, with a cache that 'domain_substitution.py revert' can undo.
  # TODO(verify): domain_substitution.list is generated from the release tarball; whether the
  # script tolerates listed files a git checkout lacks (pruning has the same issue, handled above).
  rm -f "$build/domsubcache.tar.gz"
  python3 "$ungoogled/utils/domain_substitution.py" apply \
    -r "$ungoogled/domain_regex.list" -f "$ungoogled/domain_substitution.list" \
    -c "$build/domsubcache.tar.gz" "$src"

  # 4. Ours, after ungoogled's: our hunks are written against the substituted tree.
  python3 "$ungoogled/utils/patches.py" apply "$src" "$root/engine/patches"

  printf '%s\n' "$fingerprint" >"$stamp"
  rm -f "$partial"
fi

# 5. Overrides: whole files replacing Chromium's, at the same relative path.
(cd "$root/engine/overrides" && find . -type f) | while read -r file; do
  mkdir -p "$src/$(dirname "$file")"
  cp "$root/engine/overrides/$file" "$src/$file"
done

# 6. //quickie and the Rust crates it builds. Symlinks, so edits show up without re-applying.
# TODO(verify): Siso remote execution does not follow links out of the checkout; local builds do.
link "$src/quickie" "$root/engine/quickie"
link "$src/quickie_crates" "$root/crates"

printf 'apply: %s is Quickie %s on ungoogled-chromium %s\n' "$src" "$CHROMIUM_VERSION" \
  "$UNGOOGLED_TAG"
