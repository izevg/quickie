# Quickie's GN args. engine/scripts/build writes ungoogled-chromium's flags.gn first and this file
# after it, so an assignment here wins over the same one there.

# Release build, no debug symbols: a 64 GB machine links it in reasonable time, and `out/` stays
# small. TODO(verify): official builds still emit (empty) dSYMs with symbol_level = 0.
is_official_build = true
is_debug = false
is_component_build = false
symbol_level = 0
blink_symbol_level = 0
target_cpu = "arm64"

# PGO profiles come from Google Cloud Storage; the checkout does not fetch them
# (engine/gclient.template), so profile-guided optimization is off.
chrome_pgo_phase = 0

# Rust in the tree, with cxx bindings, for //quickie and the crates it links.
enable_rust = true
enable_rust_cxx = true

# From ungoogled-chromium-macos' flags.macos.gn (156.0.8078.79-1.1), minus what assumes its
# tarball toolchains.
enable_updater = false
enable_iterator_debugging = false
fatal_linker_warnings = false
proprietary_codecs = true
ffmpeg_branding = "Chrome"
enable_swiftshader = true

# Repeated from ungoogled-chromium's flags.gn, because they are what makes the build trackerless
# (docs/privacy.md): stated here, they survive a change of that file.
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""
use_official_google_api_keys = false
safe_browsing_mode = 0
enable_reporting = false
enable_remoting = false
enable_hangout_services_extension = false
enable_mdns = false
enable_service_discovery = false
disable_fieldtrial_testing_config = true

# //quickie is linked into the browser by engine/patches/startup/link-quickie.patch; GN args
# cannot add dependencies.
