#!/bin/sh
# Fetches everything the engine is built from into .build/ (never tracked), at the revisions in
# engine/chromium.pin: depot_tools, the Chromium tag without history (gclient sync -D
# --no-history), and the ungoogled-chromium series (core and macOS). Safe to re-run: a step whose
# result is already in place is skipped.
#
#   engine/scripts/sync           fetch, or bring an unpatched checkout up to the pin
#   engine/scripts/sync --reset   also discard what engine/scripts/apply changed (patches,
#                                 pruning, domain substitution) and sync again
#
# Environment:
#   QUICKIE_BUILD_DIR    where everything goes (default: <repo>/.build); no spaces
#   QUICKIE_MIN_FREE_GB  refuse to run below this much free disk (default: 25)
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
# shellcheck source=/dev/null # engine/chromium.pin: plain assignments, nothing to check
. "$root/engine/chromium.pin"
build=${QUICKIE_BUILD_DIR:-$root/.build}
min_free_gb=${QUICKIE_MIN_FREE_GB:-25}

die() {
  printf 'sync: %s\n' "$1" >&2
  exit 1
}

# Refuses to start a heavy step on a nearly full disk: a Chromium checkout that runs out of space
# halfway is slower to repair than to refetch.
preflight() {
  mkdir -p "$1"
  free_gb=$(df -Pk "$1" | awk 'NR == 2 { print int($4 / 1048576) }')
  if [ "$free_gb" -lt "$min_free_gb" ]; then
    die "only ${free_gb} GB free on the disk of $1; need ${min_free_gb} GB (QUICKIE_MIN_FREE_GB)"
  fi
}

# Shallow-fetches $2 at ref $3 into $1 and checks that it is commit $4. Re-running is a no-op.
fetch_pinned() {
  dir=$1 url=$2 ref=$3 commit=$4
  if [ ! -d "$dir/.git" ]; then
    git init -q "$dir"
    git -C "$dir" remote add origin "$url"
  fi
  if [ "$(git -C "$dir" rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null || true)" != "$commit" ]; then
    git -C "$dir" fetch -q --depth 1 origin "$ref"
    git -C "$dir" checkout -q --detach FETCH_HEAD
  fi
  actual=$(git -C "$dir" rev-parse 'HEAD^{commit}')
  [ "$actual" = "$commit" ] || die "$url at $ref is $actual, but chromium.pin says $commit"
}

reset=false
case "${1:-}" in
  --reset) reset=true ;;
  '') ;;
  *) die "unknown argument: $1 (see the header of this script)" ;;
esac

case "$build" in
  *' '*) die "Chromium does not build in a path with spaces: $build" ;;
esac
[ "$(uname -s)" = Darwin ] || die "the engine builds on macOS only"

preflight "$build"

# depot_tools at its pinned commit; DEPOT_TOOLS_UPDATE=0 keeps it there.
export DEPOT_TOOLS_UPDATE=0
fetch_pinned "$build/depot_tools" "$DEPOT_TOOLS_REPO" "$DEPOT_TOOLS_COMMIT" "$DEPOT_TOOLS_COMMIT"
PATH="$build/depot_tools:$PATH"
export PATH

# ungoogled-chromium: core series, then the macOS platform repository.
fetch_pinned "$build/ungoogled" "$UNGOOGLED_REPO" "refs/tags/$UNGOOGLED_TAG" "$UNGOOGLED_COMMIT"
fetch_pinned "$build/ungoogled-macos" "$UNGOOGLED_MACOS_REPO" \
  "refs/tags/$UNGOOGLED_MACOS_TAG" "$UNGOOGLED_MACOS_COMMIT"

# Chromium. The applied stamp (written by engine/scripts/apply) means the tree is patched;
# syncing over a patched tree would mix revisions, so that needs --reset.
chromium=$build/chromium
stamp=$chromium/src/.quickie-applied
mkdir -p "$chromium"
if { [ -f "$stamp" ] || [ -f "$chromium/src/.quickie-applying" ]; } && [ "$reset" = false ]; then
  die "the checkout is patched; run 'engine/scripts/sync --reset' to discard that"
fi
sed "s/@CHROMIUM_VERSION@/$CHROMIUM_VERSION/" "$root/engine/gclient.template" >"$chromium/.gclient"

cd "$chromium"
if [ "$reset" = true ]; then
  # Undo apply: drop our links and stamp, then let gclient restore every repository.
  rm -f src/quickie src/quickie_crates "$stamp" src/.quickie-applying
  gclient sync -D --no-history --reset --force
else
  # TODO(verify): gclient honors --no-history for a solution pinned to refs/tags/... (it does
  # for branch heads and hashes); if not, pin "url" to CHROMIUM_COMMIT instead of the tag.
  gclient sync -D --no-history
fi

actual=$(git -C src rev-parse 'HEAD^{commit}')
[ "$actual" = "$CHROMIUM_COMMIT" ] ||
  die "src is at $actual, but chromium.pin says $CHROMIUM_COMMIT ($CHROMIUM_VERSION)"
printf 'sync: Chromium %s, ungoogled-chromium %s, ungoogled-chromium-macos %s in %s\n' \
  "$CHROMIUM_VERSION" "$UNGOOGLED_TAG" "$UNGOOGLED_MACOS_TAG" "$build"
