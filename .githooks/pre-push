#!/bin/sh
# Full quality gates before every push (docs/quality.md). Never bypass with --no-verify.
set -eu
mise="${MISE:-$HOME/.local/bin/mise}"
if [ ! -x "$mise" ]; then
  echo "pre-push: mise not found at $mise; install it or set MISE (docs/quality.md)" >&2
  exit 1
fi
exec "$mise" run --quiet pre-push
